# Sao chép file này thành server/.env rồi điền giá trị (không bắt buộc – thiếu giá trị nào thì dùng mặc định).
# KHÔNG đưa file .env lên GitHub. NGK chỉ chạy trên máy này (localhost): npm run dev hoặc npm run demo.

# Cơ sở dữ liệu: MongoDB Community chạy sẵn trên máy ở cổng 27017
MONGODB_URI=mongodb://127.0.0.1:27017/ngk

# Khoá ký phiên đăng nhập – để trống = khoá ngẫu nhiên mỗi lần chạy (khởi động lại máy chủ = phải đăng nhập lại).
# Muốn giữ đăng nhập qua các lần chạy: chuỗi ngẫu nhiên ≥ 32 ký tự, tạo nhanh bằng
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cổng máy chủ API (chỉ máy này truy cập được). Bản demo (npm run demo) mở trang web luôn ở http://localhost:<PORT>
PORT=4000
# Chỉ dùng khi chạy npm run dev: địa chỉ trang web Vite (link trong email trỏ về đây; dùng để kiểm tra Origin chống CSRF).
# Phải là http://localhost:<cổng> hoặc http://127.0.0.1:<cổng>.
APP_URL=http://localhost:5173

# Không cần đặt NODE_ENV: npm run dev = chế độ dev, npm run demo tự đặt NODE_ENV=production.

# Đăng nhập Google (để trống = ẩn nút Google). Tạo tại https://console.cloud.google.com/apis/credentials
# → Tạo OAuth client ID (loại Web application), thêm "Authorized JavaScript origins":
#   http://localhost, http://localhost:5173 (npm run dev), http://localhost:4000 (npm run demo)
GOOGLE_CLIENT_ID=

# Gửi email thật qua Gmail (để trống = hộp thư demo: link xác minh / đặt lại mật khẩu hiện ngay trên trang + in ra cửa sổ máy chủ).
# Cần bật Xác minh 2 bước cho Gmail, rồi tạo Mật khẩu ứng dụng tại https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

{
  "name": "ngk-studio",
  "version": "0.1.0",
  "private": true,
  "description": "NGK – Website thiết kế trang sức 3D (đồ án tốt nghiệp)",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "demo": "node scripts/demo.mjs",
    "test": "npm test -w server",
    "lint": "eslint .",
    "seed:demo": "npm run seed:demo -w server --",
    "seed:demo:xoa": "npm run seed:demo:xoa -w server",
    "admin": "npm run admin -w server --"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  }
}
